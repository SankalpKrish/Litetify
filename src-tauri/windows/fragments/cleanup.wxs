<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
    <!-- Recursively delete leftover runtime files (e.g. mods/) so INSTALLDIR
         can be removed. Referenced from bundle.windows.wix.componentRefs. -->
    <Fragment>
        <DirectoryRef Id="INSTALLDIR">
            <Component Id="CleanupInstallDirLeftovers" Guid="8f3c1a2e-9b74-4d1c-a6e5-2c7f0b91d4e8">
                <RegistryValue Root="HKCU"
                               Key="Software\Litetify\Litetify"
                               Name="CleanupInstallDir"
                               Type="integer"
                               Value="1"
                               KeyPath="yes" />
                <RemoveFile Id="RemoveInstallDirFiles" Name="*" On="uninstall" />
            </Component>
        </DirectoryRef>

        <CustomAction Id="RemoveRuntimeLeftovers"
                      Directory="INSTALLDIR"
                      ExeCommand="cmd.exe /c if exist mods rmdir /s /q mods"
                      Execute="deferred"
                      Impersonate="no"
                      Return="ignore" />

        <InstallExecuteSequence>
            <Custom Action="RemoveRuntimeLeftovers" Before="RemoveFiles">REMOVE="ALL"</Custom>
        </InstallExecuteSequence>
    </Fragment>
</Wix>
